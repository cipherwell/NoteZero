<?xml version="1.0" encoding="utf-8"?>
<!--
  Static launcher shortcuts (quick capture). The intent is handled by MainActivity, which
  routes it through AppRoot: if the vault is locked the user unlocks first and the pending
  new-note request is honoured afterwards; the note is created only through the normal
  encrypted repository path (no bypass, no extra permission).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="new_note"
        android:shortcutLongLabel="@string/shortcut_new_note_long"
        android:shortcutShortLabel="@string/shortcut_new_note_short">
        <intent
            android:action="com.cipherwell.notezero.SHORTCUT_NEW_NOTE"
            android:targetClass="com.cipherwell.notezero.MainActivity"
            android:targetPackage="com.cipherwell.notezero" />
    </shortcut>
</shortcuts>
