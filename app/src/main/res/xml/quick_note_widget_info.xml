<?xml version="1.0" encoding="utf-8"?>
<!-- Static quick-capture tile: no periodic updates (updatePeriodMillis=0), no
     configuration activity, no preview of vault content. 2x1 cells on modern launchers. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_quick_note_description"
    android:initialLayout="@layout/widget_quick_note"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
