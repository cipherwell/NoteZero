<?xml version="1.0" encoding="utf-8"?>
<!-- NoteZero: nothing leaves the device via Android backup. Vault data is
     ciphertext only; a backup of it without the vault key is worthless, but we
     exclude everything anyway so no metadata leaks through cloud backup. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
